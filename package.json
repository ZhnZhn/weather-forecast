{
  "name": "weather-forecast",
  "version": "0.3.0",
  "description": "Web app Weather Forecast",
  "main": "index.js",
  "scripts": {
    "dev": "webpack serve --config webpack.dev.js",
    "dev:rspack": "rspack serve --config rspack.dev.js",
    "test": "rstest --config rstest.config.mjs",
    "test:watch": "rstest --watch --config rstest.config.mjs",
    "css:min": "node ut/css-min.js",
    "css:sass": "node ut/css-sass.js",
    "css:all": "npm run css:sass && npm run css:min",
    "transpile": "babel ./src --out-dir ./js --source-maps --ignore test.js",
    "transpile:all": "babel ./src --out-dir ./js --source-maps",
    "lint:one": "eslint -c eslint.config.js",
    "lint:biome": "npx @biomejs/biome lint ./src --colors=off",
    "build:prod": "webpack --color --progress --config webpack.prod.js",
    "build:rspack:prod": "rspack build --config rspack.prod.js",
    "stats": "npm run stats:json && npm run stats:report",
    "stats:json": "webpack --config webpack.dll-jsx.js --profile --json > stats.json",
    "stats:report": "webpack-bundle-analyzer stats.json --no-open --mode static",
    "stats:dll": "webpack --color --progress --config webpack.dll.js json > stats-dll.json"
  },
  "author": "Yevhenii Molodyi",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "leaflet": "^1.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1",
    "redux-saga": "^1.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@biomejs/biome": "^2.6.4",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rspack/cli": "^2.2.9",
    "@rspack/dev-server": "^2.2.2",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@rstest/core": "^0.12.5",
    "@swc/helpers": "^0.5.23",
    "@testing-library/react": "^16.3.3",
    "babel-loader": "^10.1.1",
    "clean-css": "^5.3.3",
    "d3-color": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-redux-saga": "^1.3.3",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.3",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^7.2.3"
  },
  "overrides": {
    "glob": "~14.0.3",
    "minimatch": "~11.0.3"
  }
}
